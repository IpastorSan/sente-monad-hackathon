{
  "name": "@sente/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "setup:web": "setup-skia-web public",
    "web": "pnpm run setup:web && expo start --web",
    "export:web": "pnpm run setup:web && expo export --platform web --output-dir dist-web",
    "read-block": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/read-block.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "claim:ausd": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/claim-ausd.ts",
    "trade:live": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=../../.env scripts/trade-live.ts",
    "prf:equivalence": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/prf-equivalence.ts",
    "e2e:web-reload": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/web-reload-e2e.ts"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@sente/presets": "workspace:*",
    "@sente/venues": "workspace:*",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "fast-text-encoding": "^1.0.6",
    "permissionless": "^0.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-passkey": "3.6.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@sente/mandate": "workspace:*",
    "@types/node": "^26.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.2",
    "playwright-core": "1.64.0",
    "typescript": "~6.0.3"
  }
}
