# REQUIRED: React Native's Metro bundler cannot resolve pnpm's default symlinked
# store layout. Without a hoisted node_modules, apps/mobile fails at bundle time
# with confusing "Unable to resolve module" errors for transitive deps.
# Do not change this to `isolated`.
node-linker=hoisted

# Expo/RN packages have loose or missing peer ranges; failing the install on them
# is noise, not signal.
strict-peer-dependencies=false
auto-install-peers=true
