{
  "name": "sente-kuru-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Envio HyperIndex for Kuru Spot V2 + Perpl fills on Monad testnet (SEN-25)",
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "envio start",
    "test": "node --no-warnings --test src/lib/*.test.ts",
    "test:watch": "node --no-warnings --test --watch src/lib/*.test.ts",
    "typecheck": "npm run codegen && tsc -p tsconfig.json --noEmit",
    "verify:topics": "node --experimental-strip-types --no-warnings scripts/verify-config-topics.ts"
  },
  "dependencies": {
    "envio": "3.12.0",
    "viem": "^2.54.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
