{
  "name": "@sente/api",
  "version": "0.0.0",
  "private": true,
  "description": "Sente backend — auth, wallets, venue routing, agents, credits, gas.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "probe:openrouter": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=../../.env scripts/openrouter-probe.ts",
    "privy:keys": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/privy-keys.ts",
    "probe:privy": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/privy-probe.ts",
    "probe:privy-sponsor": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/privy-sponsor-probe.ts",
    "agent:fund": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/fund-agent.ts",
    "agent:venues-live": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/agent-venues-live.ts",
    "agent:withdraw-live": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/agent-withdraw-live.ts",
    "agent:run-live": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/agent-run-live.ts",
    "demo:refusal": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-refusal.ts",
    "consensus:watch": "node --env-file-if-exists=../../.env --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/consensus-watch.ts",
    "erc8004:live": "node --conditions=source --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/erc8004-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@sente/mandate": "workspace:*",
    "@sente/venues": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "permissionless": "^0.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viem": "^2.56.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "testEnvironment": "node",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "source",
        "node",
        "node-addons"
      ]
    }
  }
}
