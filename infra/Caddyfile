{
	email {$ACME_EMAIL}
}

sente.lol {
	# Two halves, and the order is the whole point (SEN-168):
	#
	#   /.well-known/*  infra/site — the passkey association files.
	#   everything else infra/web  — the Expo web export, a single-page app.
	#
	# The SPA needs a catch-all fallback to index.html, and a catch-all that ever
	# answered /.well-known/assetlinks.json would return 200 text/html: no error
	# anywhere, and Android silently stops offering every user's passkey to the
	# app. `handle` blocks are mutually exclusive and Caddy sorts them by matcher
	# specificity, so the path-matched block below wins regardless of where it is
	# written. It is written first anyway, for the reader. verify.sh checks it
	# from outside: /.well-known/does-not-exist must be a 404, not the app.

	# The apex MUST serve these directly. A redirect here — including the
	# apex -> www that many registrars add by default — silently breaks
	# passkey association on both platforms.
	handle /.well-known/* {
		root * /srv/site
		header Cache-Control "public, max-age=300"
		# A plain file server: an unknown file is a 404. NEVER add try_files or
		# a rewrite to index.html in this block.
		file_server
	}

	# Android only. iOS is deliberately out of scope: the associated-domains
	# entitlement needs a paid Apple Developer account, and building or
	# device-testing an iOS app needs a Mac we do not have. If iOS is ever
	# added, apple-app-site-association has no file extension and Caddy will
	# sniff it as text/plain — it needs an explicit
	# `header @aasa Content-Type application/json` matcher in the block above.

	handle {
		root * /srv/web
		encode zstd gzip

		# Content-hashed bundle names: safe to cache forever.
		@hashed path /_expo/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Skia's CanvasKit (SEN-164). Its name is NOT hashed, so a Skia upgrade
		# serves new bytes under the same URL: a day, not a year.
		@wasm path /canvaskit.wasm
		header @wasm Cache-Control "public, max-age=86400"

		# Client-side routes (/agents/…, /markets, …) get the app shell. Not for
		# a missing bundle or asset, though: a stale /_expo/static/… chunk
		# answered with HTML fails as a confusing MIME error in the browser,
		# where a 404 says what happened.
		@route {
			not path /_expo/* /assets/*
			not file
		}
		rewrite @route /index.html

		# The shell names the current bundle hashes, so it must be revalidated
		# on every load or a redeploy is invisible until the heuristic cache
		# expires. `header` runs before `rewrite`, hence the two matchers.
		@shell path / /index.html
		header @shell Cache-Control "no-cache"
		header @route Cache-Control "no-cache"

		file_server
	}
}

# www is a convenience only. The rpId is the apex and nothing about passkeys
# may depend on this host.
www.sente.lol {
	redir https://sente.lol{uri} permanent
}

# services/api (SEN-51). Its own hostname rather than a path prefix under the
# apex, for one reason that is not taste: the apex serves `/.well-known/*` and
# those files must keep returning 200 with no redirect (../CLAUDE.md, "Permanent,
# unchangeable values"). A `handle_path /api/*` on the apex puts a reverse proxy
# and a file server in the same site block, one ordering mistake away from the
# apex answering a passkey association request out of Nest. A separate host
# cannot make that mistake.
#
# THE RPID IS UNAFFECTED. A passkey scoped to `sente.lol` works from every name
# below it, so `api.sente.lol` needs no association file of its own and must
# never be given one.
#
# DNS FIRST: `A api.sente.lol -> <the box's IP>` must resolve before this block
# is deployed, or Caddy burns a Let's Encrypt failed-authorisation against the
# account (five per hostname per hour). `deploy.sh` checks it and refuses.
api.sente.lol {
	# Compose puts both containers on the same network, so `api` is the service
	# name from docker-compose.yml. Nothing publishes port 3000 on the host: the
	# API is reachable only through this proxy, over TLS.
	reverse_proxy api:3000 {
		# Caddy already sends X-Forwarded-For/-Proto/-Host. NOTE, and it is a
		# real behaviour change on deploy: Express only believes those with
		# `trust proxy` set, which `services/api/src/main.ts` does not set, so
		# `@Ip()` sees this proxy's container address. The per-IP backstop on
		# POST /gas/drip therefore becomes one shared bucket
		# (GAS_DRIP_RATE_LIMIT_MAX per window for everyone). It fails closed,
		# not open — the per-address and per-user caps in the drip ledger are
		# untouched — but it can refuse a judge mid-demo. See docs/deploy.md,
		# "Decisions still open".
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}

	# Responses only; the request body Caddy forwards is byte-for-byte what it
	# received, which is what POST /webhooks/alchemy's HMAC is computed over
	# (services/api/src/webhooks/raw-body.ts).
	encode zstd gzip
}
