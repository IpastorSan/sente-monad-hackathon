{
	email {$ACME_EMAIL}
}

sente.lol {
	root * /srv/site

	# The apex MUST serve these directly. A redirect here — including the
	# apex -> www that many registrars add by default — silently breaks
	# passkey association on both platforms.
	@wellknown path /.well-known/*
	header @wellknown Cache-Control "public, max-age=300"

	# Android only. iOS is deliberately out of scope: the associated-domains
	# entitlement needs a paid Apple Developer account, and building or
	# device-testing an iOS app needs a Mac we do not have. If iOS is ever
	# added, apple-app-site-association has no file extension and Caddy will
	# sniff it as text/plain — it needs an explicit
	# `header @aasa Content-Type application/json` matcher.

	file_server
}

# www is a convenience only. The rpId is the apex and nothing about passkeys
# may depend on this host.
www.sente.lol {
	redir https://sente.lol{uri} permanent
}
