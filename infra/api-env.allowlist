# Which variables `push-secrets.sh` is allowed to copy from your local `.env`
# into `/opt/sente/api.env` on the box. One name per line; `#` comments and
# blank lines ignored.
#
# THIS FILE IS AN ALLOWLIST, NOT DOCUMENTATION. It exists so the transfer is
# reviewable: what leaves this laptop is the intersection of your `.env` and
# this list, and nothing else. `push-secrets.sh` prints every key in your `.env`
# that is on neither this list nor the DENY list at the bottom — so a variable
# added to `.env.example` later gets noticed instead of silently not deployed.
#
# `.env.example` is the reference for what each one means and which are secret.

# --- auth (services/api/src/auth) ---
# AUTH_SESSION_SECRET is the one variable the API cannot boot without.
AUTH_SESSION_SECRET
AUTH_SESSION_TTL_S

# --- smart accounts / bundler / paymaster (services/api/src/wallet) ---
# PIMLICO_BUNDLER_URL and ALCHEMY_RPC_URL carry their API key IN THE PATH, so
# the whole URL is a secret.
PIMLICO_BUNDLER_URL
PIMLICO_SPONSORSHIP_POLICY_ID
WALLET_BUNDLER_URL
WALLET_PAYMASTER_PROVIDER
ALCHEMY_RPC_URL
ALCHEMY_GAS_POLICY_ID
WALLET_CONFIRMATION_POLL_MS
WALLET_CONFIRMATION_TIMEOUT_MS
WALLET_PREPARE_TTL_MS
# Floor between two sponsored sends from one user wallet; a trade's steps wait on it.
WALLET_SEND_SPACING_MS

# --- the user's own manual trading (services/api/src/trade) ---
# Off unless set to 1. Turning it on also needs a web build and an APK with
# EXPO_PUBLIC_USER_TRADING=1 (docs/deploy.md, "Turning user trading on").
USER_TRADING
# Perps in the app (SEN-174). Read only with USER_TRADING on.
USER_TRADING_PERPL
# One atomic batch per trade instead of one send per step. Off unless 1.
USER_TRADE_ATOMIC_BATCH

# --- Privy (agent wallets, the user's wallet, the mandate policies) ---
# The two P-256 keys are the most dangerous values in the file: replacing one
# orphans every wallet or policy it owns.
PRIVY_APP_ID
PRIVY_APP_SECRET
PRIVY_AGENT_AUTH_KEY
PRIVY_MANDATE_OWNER_KEY
PRIVY_AGENT_QUORUM_ID
PRIVY_MANDATE_QUORUM_ID

# --- Monad ---
# MONAD_WS_URL must be reachable from the box for the consensus service to
# report anything past `proposed`; it falls back to HTTP polling when it is not.
MONAD_TESTNET_RPC_URL
MONAD_WS_URL

# --- gas drip (real testnet money; losing these keys loses the funds) ---
GAS_DRIP_PRIVATE_KEYS
GAS_DRIP_AMOUNT_MON
GAS_DRIP_DAILY_CAP_MON
GAS_DRIP_GAS_LIMIT
GAS_DRIP_GAS_LIMIT_CONTRACT
GAS_DRIP_AGENT_AMOUNT_MON
GAS_DRIP_AGENT_MAX_PER_USER_PER_DAY
GAS_DRIP_SENDER_SPACING_MS
GAS_DRIP_AGENT_RECEIPT_TIMEOUT_MS
GAS_DRIP_RATE_LIMIT_MAX
GAS_DRIP_RATE_LIMIT_WINDOW_MS

# --- starter kit (SEN-170): AUSD + USDC once per new user; its own key, never a GAS_DRIP one ---
STARTER_DRIP_PRIVATE_KEY
STARTER_DRIP_AUSD
STARTER_DRIP_USDC
STARTER_DRIP_DAILY_CAP_USERS

# --- model credits ---
OPENROUTER_MANAGEMENT_KEY
OPENROUTER_DEFAULT_LIMIT_USD
# Off unless 1|true; leave it off until a payment rail exists (SEN-183).
CREDITS_PURCHASES_ENABLED

# --- agent runner ---
# AGENT_TICK_SECONDS is the DEFAULT cadence for agents without a schedule of
# their own (SEN-71). Unset, those run only by hand; agents their owners
# scheduled still run. Leave it unset on the box unless you mean to run every
# unscheduled agent on a timer, spending judges' credits unprompted.
AGENT_TICK_SECONDS
AGENT_RUN_TIMEOUT_MS
AGENT_RUN_MAX_ITERATIONS
AGENT_RUN_MAX_TOKENS
AGENT_WRITE_SPACING_MS
AGENT_RUNNER_THINKING
AGENT_PRECHECK
AGENT_MANDATE_OWNER
# The scheduler's own knobs (SEN-71); live whatever AGENT_TICK_SECONDS says,
# because per-agent schedules (SEN-67) need them. POLL_SECONDS=off stops all scheduled runs.
AGENT_SCHEDULER_POLL_SECONDS
AGENT_SCHEDULE_MAX_CONCURRENT
AGENT_SCHEDULE_MAX_RUNS_PER_DAY
AGENT_SCHEDULE_MIN_CREDITS_USD
# The resting-order fill watcher.
AGENT_FILL_POLL_SECONDS
AGENT_FILL_MAX_BLOCK_RANGE
# Required: STATE_DIR is pinned on the box, and the API will not boot without
# it. Encrypts agent-secrets.json (the agents' Perpl keys, SEN-148).
AGENT_SECRETS_KEY

# --- signals ---
NANSEN_API_KEY

# --- ERC-8004 identity and reputation ---
ERC8004_REGISTRAR_KEY
ERC8004_REVIEWER_KEY
ERC8004_AGENT_BASE_URL
ERC8004_MCP_ENDPOINT
ERC8004_IMAGE_URL
ERC8004_REGISTER_GAS
ERC8004_FEEDBACK_GAS

# --- Alchemy Notify webhook (SEN-30) ---
# The signing key proves a delivery came FROM Alchemy; the auth token
# authenticates US calling Alchemy. Different secrets, opposite directions.
ALCHEMY_WEBHOOK_SIGNING_KEY
ALCHEMY_NOTIFY_AUTH_TOKEN
ALCHEMY_NOTIFY_WEBHOOK_ID
ALCHEMY_NOTIFY_TIMEOUT_MS

# --- portfolio value history (SEN-152) ---
VALUE_HISTORY_TICK_SECONDS
VALUE_HISTORY_EVERY_SECONDS

# --- leaderboard ---
ENVIO_GRAPHQL_URL

# ---------------------------------------------------------------------------
# SEN-184: the Sente builder fee on Kuru (off when the address is unset)
KURU_BUILDER_ADDRESS
KURU_BUILDER_FEE_PPS
KURU_BUILDER_AGENTS

# DENY — never leaves this laptop, and push-secrets.sh says why if it finds one.
# A `DENY ` prefix, a name (or a name ending in `*` to match a whole prefix),
# then the reason, which is printed verbatim if the key turns up.
# ---------------------------------------------------------------------------
DENY AUTH_PLACEHOLDER          the API refuses to boot with it under NODE_ENV=production; it trusts a forgeable header
DENY OPENROUTER_API_KEY        the shared dev inference key; refused under NODE_ENV=production
DENY GAS_DRIP_DRY_RUN          refused true under NODE_ENV=production, and a deploy that never broadcasts is not a deploy
DENY NODE_ENV                  docker-compose.yml pins it to production and outranks this file
DENY PORT                      docker-compose.yml pins it to 3000, the port Caddy proxies to
DENY STATE_DIR                 docker-compose.yml pins it to the bind-mounted /var/lib/sente/state
DENY TREASURY_PRIVATE_KEY      dev scripts only (agent:fund, probes); the API never reads it, and it is real testnet money
DENY PRIVY_AGENT_VENUES_*      fixtures for the agent:venues-live / withdraw probes; the API never reads them
DENY EXPO_PUBLIC_*             compiled into the app bundle, so public by construction; the server never reads them
DENY PERPL_DEV_*               a dev account for local live scripts, not something the API reads
DENY PRIVY_PROBE_*             bookkeeping written by probe:privy; nothing reads it
DENY ENVIO_MONAD_RPC_URL       read by services/indexer, not by the API
DENY ANTHROPIC_API_KEY         the API never uses it, and the agent runner talks to OpenRouter, which must never receive a real Anthropic key (the SDK reads this ambiently; openrouter-client.ts blocks it)
