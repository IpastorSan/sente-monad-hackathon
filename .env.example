# ---------------------------------------------------------------------------
# Sente workspace environment
#
# Copy to `.env` at the repo root and fill in. `.env` is gitignored.
# Anything the mobile app must read at runtime MUST be prefixed EXPO_PUBLIC_ —
# Expo only inlines those, and by definition they are NOT secret (they ship
# inside the app bundle). Never put a private key behind an EXPO_PUBLIC_ name.
# ---------------------------------------------------------------------------

# ERC-4337 bundler + paymaster endpoint (Pimlico), used to sponsor and relay
# UserOperations for smart accounts on Monad. Includes the API key in the URL,
# so treat the whole string as a secret. Server-side only.
PIMLICO_BUNDLER_URL=https://api.pimlico.io/v2/10143/rpc?apikey=REPLACE_ME

# Privy application id — embedded/managed wallets and auth. This one is a
# public identifier and is safe in the client bundle.
PRIVY_APP_ID=

# Privy application secret — server-side only. Used by services/api to verify
# Privy access tokens and to call Privy's server API. Never ship to the app.
PRIVY_APP_SECRET=

# JSON-RPC endpoint for Monad testnet (chain id 10143). Default public node is
# https://testnet-rpc.monad.xyz; override with a dedicated provider for rate
# limits. Read by services/api.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Comma-separated list of hex private keys for the gas-drip faucet wallets that
# top up new users with testnet MON. Multiple keys let the drip service rotate
# senders and avoid nonce contention. HIGHLY SENSITIVE — server-side only.
GAS_DRIP_PRIVATE_KEYS=

# How much MON each new account receives. Enough for a handful of transactions,
# deliberately not enough to be worth farming. Default 0.1.
GAS_DRIP_AMOUNT_MON=0.1

# Global faucet outflow ceiling per UTC day, checked BEFORE any send so a leak
# cannot drain the wallet overnight. Default 25.
GAS_DRIP_DAILY_CAP_MON=25

# Explicit gas limit for the native transfer. Monad charges on gas_limit, not
# gas used, so an over-estimate is money spent rather than reserved — never set
# this from an estimateGas result. Default 21000.
GAS_DRIP_GAS_LIMIT=21000

# Coarse per-IP backstop on POST /gas/drip. Defaults: 5 attempts / 60000 ms.
GAS_DRIP_RATE_LIMIT_MAX=5
GAS_DRIP_RATE_LIMIT_WINDOW_MS=60000

# Local/CI only. Runs every guard for real but never broadcasts, returning a
# synthetic tx hash — lets the refusal paths be exercised end to end without a
# funded key. Refuses to switch on when NODE_ENV=production.
GAS_DRIP_DRY_RUN=false

# OpenRouter management/provisioning key. services/api uses it to mint
# per-agent scoped API keys with spend limits, rather than handing agents this
# key directly. Server-side only.
OPENROUTER_MANAGEMENT_KEY=

# Base URL of services/api as seen from the device. In development on a
# physical device this must be your machine's LAN IP, not localhost — the
# phone's localhost is the phone.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Chain the mobile app talks to: "testnet" (10143) or "mainnet" (143).
EXPO_PUBLIC_MONAD_NETWORK=testnet

# Optional RPC override for the mobile app. Falls back to the chain's default
# public RPC from viem when unset.
EXPO_PUBLIC_MONAD_RPC_URL=
