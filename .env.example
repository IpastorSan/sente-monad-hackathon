# ---------------------------------------------------------------------------
# Sente workspace environment
#
# Copy to `.env` at the repo root and fill in. `.env` is gitignored.
# Anything the mobile app must read at runtime MUST be prefixed EXPO_PUBLIC_ —
# Expo only inlines those, and by definition they are NOT secret (they ship
# inside the app bundle). Never put a private key behind an EXPO_PUBLIC_ name.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Session auth (SEN-37, services/api/src/auth)
#
# The phone proves it holds the passkey-derived key for an address by signing a
# nonce the server chose (POST /auth/challenge -> POST /auth/session), and gets
# a bearer token every guarded route accepts. There is no password and no
# server-side user record: the address IS the identity.
# ---------------------------------------------------------------------------

# HMAC key for session tokens: 32 bytes of hex, `openssl rand -hex 32`.
# REQUIRED — the API refuses to boot without it (unless AUTH_PLACEHOLDER=1).
# Rotating it invalidates every live session, which is the point.
AUTH_SESSION_SECRET=

# Session lifetime in seconds. Default 86400 (a day), maximum 604800 (a week).
AUTH_SESSION_TTL_S=86400

# DEV ONLY. Keeps the pre-SEN-37 `x-sente-user-id` header working for requests
# that carry no bearer token, so the curl recipes in docs/ and the API scripts
# still work without a passkey. That header is forgeable by anyone who knows an
# address, so the API REFUSES TO BOOT with this set under NODE_ENV=production.
# With it set and AUTH_SESSION_SECRET unset, tokens are signed with a key
# generated at boot and stop verifying when the process restarts.
AUTH_PLACEHOLDER=

# ---------------------------------------------------------------------------
# Smart accounts (services/api/src/wallet)
#
# GAS SPONSORSHIP NEEDS A KEY. Pimlico's keyless PUBLIC endpoint
# (https://public.pimlico.io/v2/10143/rpc) serves the BUNDLER methods for Monad
# testnet perfectly well — verified 2026-09-09: eth_chainId, supported entry
# points, pimlico_getUserOperationGasPrice and a real
# eth_estimateUserOperationGas simulation. Its PAYMASTER methods do not work:
# pm_getPaymasterStubData and pm_sponsorUserOperation both answer "Sponsorship
# policy ID is required for this API key". So sponsorship requires a real
# Pimlico account, a keyed URL, and a sponsorship policy.
#
# With none of these set, the API boots, builds and signs UserOperations
# normally, reports `sponsored: false`, and the smart account pays its own gas.
# ---------------------------------------------------------------------------

# ERC-4337 bundler + paymaster endpoint (Pimlico). Includes the API key in the
# URL, so treat the whole string as a secret. Server-side only. Unset falls back
# to the keyless public endpoint (bundler only, no sponsorship).
PIMLICO_BUNDLER_URL=https://api.pimlico.io/v2/10143/rpc?apikey=REPLACE_ME

# Pimlico sponsorship policy id (dashboard -> Sponsorship Policies), e.g.
# sp_xxxxxxxx. REQUIRED for gas sponsorship: without it every paymaster call is
# refused, whatever the URL.
PIMLICO_SPONSORSHIP_POLICY_ID=

# Optional bundler override, independent of the paymaster. Useful to point the
# bundler at one vendor and sponsorship at another.
WALLET_BUNDLER_URL=

# Which ERC-7677 paymaster sponsors gas: pimlico | alchemy | none. Unset is
# inferred from whichever policy id is present, and `none` when neither is.
# Swapping vendors is this line plus their url/policy — both speak ERC-7677.
WALLET_PAYMASTER_PROVIDER=

# Alchemy Gas Manager, the alternative to Pimlico. Their chain table lists Monad
# testnet as supported for bundler, sponsorship and ERC-20 gas.
ALCHEMY_RPC_URL=
ALCHEMY_GAS_POLICY_ID=

# UserOperation confirmation polling. 300ms is Monad's block time — do not copy
# Base's 200ms flash-block cadence, it just costs requests. A timeout leaves the
# operation `pending`, never `failed`: it may still land.
WALLET_CONFIRMATION_POLL_MS=300
WALLET_CONFIRMATION_TIMEOUT_MS=90000

# How long a prepared UserOperation stays signable before its fees go stale and
# its prepare id is refused. (A device-signed SEND carries no fee quote and uses
# the 5-minute PREPARED_APPROVAL_TTL_MS instead.)
WALLET_PREPARE_TTL_MS=120000

# The floor between two Privy-sponsored sends from ONE user wallet (SEN-42). The
# first sponsored send EIP-7702-delegates the wallet and bumps its nonce, so a
# send composed before that lands is refused with an "EIP-7702 nonce mismatch";
# 1.5s was enough live, 4s has room for a slower block. A floor, not a delay —
# a wallet that last sent a minute ago waits not at all.
WALLET_SEND_SPACING_MS=4000

# Privy application id — embedded/managed wallets and auth. This one is a
# public identifier and is safe in the client bundle.
PRIVY_APP_ID=

# Privy application secret — server-side only. Used by services/api to verify
# Privy access tokens and to call Privy's server API. Never ship to the app.
PRIVY_APP_SECRET=

# ---------------------------------------------------------------------------
# Agent wallets (SEN-3, services/api/src/agents)
#
# Each agent trades from a Privy server wallet whose key lives in Privy's
# enclave, bounded by its mandate compiled to a Privy policy. TWO P-256
# authorization keys, deliberately different:
#   PRIVY_AGENT_AUTH_KEY     owns the wallets; approves every signature
#   PRIVY_MANDATE_OWNER_KEY  owns the policies; the only key that can change one
# so the key that spends can never raise its own limit. Generate both straight
# into .env, without printing them:
#   pnpm --filter @sente/api run privy:keys
# base64 PKCS#8 DER (a "wallet-auth:" prefix is accepted). HIGHLY SENSITIVE.
# Replacing one orphans every wallet or policy it owns. All four of
# PRIVY_APP_ID/SECRET and these two, or none: a partial set fails at boot.
# Live check: pnpm --filter @sente/api run probe:privy
# (docs/privy-policy-enforcement.md, "Verified live on 10143").
# ---------------------------------------------------------------------------
PRIVY_AGENT_AUTH_KEY=
PRIVY_MANDATE_OWNER_KEY=

# Owner quorums to reuse. Unset, the API registers new ones on first use and
# logs their ids — pin them here (Privy cannot list quorums: GET is 405).
# probe:privy fills these in if they are empty.
PRIVY_AGENT_QUORUM_ID=
PRIVY_MANDATE_QUORUM_ID=

# probe:privy records every object it creates as PRIVY_PROBE_* (wallet, policy,
# quorum and aggregation ids). Not read by the API; they are the only record of
# the probe's objects, because Privy's list endpoints answer 405.

# JSON-RPC endpoint for Monad testnet (chain id 10143). Default public node is
# https://testnet-rpc.monad.xyz; override with a dedicated provider for rate
# limits. Read by services/api.
#
# THIS ONE VARIABLE POINTS EVERY HTTP CHAIN READ IN THE API AT A PROVIDER —
# wallet balances and sponsorship (wallet.config.ts), the gas drip
# (gas.config.ts), the venue clients (agents/venues/agent-venues.providers.ts),
# the ERC-8004 registries (agents/reputation/erc8004.ts) and the consensus
# service's HTTP fallback (chain/chain.module.ts). Two things do NOT resolve
# through it, by design: MONAD_WS_URL below (a different transport) and
# ENVIO_MONAD_RPC_URL at the bottom (read by services/indexer, not the API).
#
# For Alchemy: https://monad-testnet.g.alchemy.com/v2/<API_KEY>. TREAT THE WHOLE
# URL AS A SECRET — the key is in the path, so anyone who sees the URL can spend
# the account's compute units. Details, and why: docs/alchemy.md.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# WebSocket endpoint for Monad's `monadNewHeads` subscription — the source the
# consensus service follows so the Agent Ledger can show how far a trade's block
# has committed (SEN-21). Deliberately separate from MONAD_TESTNET_RPC_URL: the
# two are different transports, and the socket can be moved without touching the
# HTTP paths that sign and broadcast. While the socket is down the service falls
# back to eth_getBlockByNumber(latest|safe|finalized) on the HTTP endpoint,
# which cannot report `Verified`.
MONAD_WS_URL=wss://testnet-rpc.monad.xyz

# Comma-separated list of hex private keys for the gas-drip faucet wallets that
# top up new users with testnet MON. Multiple keys let the drip service rotate
# senders and avoid nonce contention. HIGHLY SENSITIVE — server-side only.
GAS_DRIP_PRIVATE_KEYS=

# How much MON each new account receives. Enough for a handful of transactions,
# deliberately not enough to be worth farming. Default 0.1.
GAS_DRIP_AMOUNT_MON=0.1

# Global faucet outflow ceiling per UTC day, checked BEFORE any send so a leak
# cannot drain the wallet overnight. Default 25.
GAS_DRIP_DAILY_CAP_MON=25

# Explicit gas limit for the native transfer to an address with NO code (an EOA,
# or a Kernel account not deployed yet). Monad charges on gas_limit, not gas
# used, so an over-estimate is money spent rather than reserved — never set
# this from an estimateGas result. Default 21000.
GAS_DRIP_GAS_LIMIT=21000

# Explicit gas limit for the native transfer to an address WITH code (a deployed
# Kernel smart account — its receive() runs, measured 40,995 gas, so 21000
# reverts). Chosen per recipient via eth_getCode, so EOAs never pay it.
# Default 46000.
GAS_DRIP_GAS_LIMIT_CONTRACT=46000

# Agent drip (SEN-14): MON sent to each hired agent's own EOA so it can pay gas
# for its trades. Default 0.15 — SEN-6 measured 0.138 MON of gas for an agent's
# first seven transactions (Kuru + Perpl onboarding). Refused when the address
# already holds this much. Counts against GAS_DRIP_DAILY_CAP_MON.
GAS_DRIP_AGENT_AMOUNT_MON=0.15

# Agents one user may have funded per UTC day. Default 3. Funding an agent
# never uses up the user's own drip.
GAS_DRIP_AGENT_MAX_PER_USER_PER_DAY=3

# Minimum gap between two drips (user or agent) from the same faucet key,
# counted from the previous receipt. Monad's reserve balance reverts a second MON send in quick
# succession from a key holding under 10 MON, and still charges the gas
# (CLAUDE.md gotcha 12). Measured in SEN-16: a second send 0-2 blocks after the
# first reverts, 3+ blocks after it lands. Default 2000 (~5 blocks).
GAS_DRIP_SENDER_SPACING_MS=2000

# How long a drip (user or agent) waits for its receipt before reporting it
# unconfirmed (it is never re-sent). Default 15000.
GAS_DRIP_AGENT_RECEIPT_TIMEOUT_MS=15000

# Coarse per-IP backstop on POST /gas/drip. Defaults: 5 attempts / 60000 ms.
GAS_DRIP_RATE_LIMIT_MAX=5
GAS_DRIP_RATE_LIMIT_WINDOW_MS=60000

# Local/CI only. Runs every guard for real but never broadcasts, returning a
# synthetic tx hash — lets the refusal paths be exercised end to end without a
# funded key. Refuses to switch on when NODE_ENV=production.
GAS_DRIP_DRY_RUN=false

# OpenRouter management/provisioning key. services/api uses it to mint
# per-agent scoped API keys with spend limits, rather than handing agents this
# key directly. Server-side only.
OPENROUTER_MANAGEMENT_KEY=

# ---------------------------------------------------------------------------
# Credits (MOV-279)
#
# Each user gets their own OpenRouter API key, minted with the management key
# above, carrying a hard USD spending limit that resets monthly (00:00 UTC on
# the 1st). OpenRouter meters and enforces it; we do no metering of our own.
# Unset OPENROUTER_MANAGEMENT_KEY and /credits refuses with credits_unconfigured.
# Live check: `pnpm --filter @sente/api run probe:openrouter` (docs/openrouter.md).
# ---------------------------------------------------------------------------

# Monthly limit, in USD, on each newly provisioned user key. Default 5.
OPENROUTER_DEFAULT_LIMIT_USD=5

# DEV ONLY (SEN-18): one shared OpenRouter INFERENCE key that every user draws on,
# with no per-user limit. Used only when OPENROUTER_MANAGEMENT_KEY is unset; the
# API refuses to boot with it when NODE_ENV=production.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Agent runner (SEN-8)
#
# POST /agents/:id/run runs one agent once: a Tool Runner loop over the gated
# tools, billed to its owner's OpenRouter key above. Every variable is optional;
# a malformed value fails the boot. Details: docs/agents.md, "The runner".
# ---------------------------------------------------------------------------

# Seconds between scheduled runs of EVERY active agent. Unset, empty, 0 or off
# = no scheduler (the default): it spends users' credits unprompted. Min 30.
AGENT_TICK_SECONDS=

# Wall-clock budget per run (AbortController). Default 180000.
AGENT_RUN_TIMEOUT_MS=180000

# Model requests per run (the Tool Runner's max_iterations). Default 12.
AGENT_RUN_MAX_ITERATIONS=12

# max_tokens per request. Default 4096.
AGENT_RUN_MAX_TOKENS=4096

# Minimum gap between two signing writes of one agent, from the end of the
# previous one. Privy enforces its rolling cap late: a sign straight after
# another overshot it, one 5 s later was refused (SEN-3). 0 = off. Default 5000.
AGENT_WRITE_SPACING_MS=5000

# off (default) or adaptive. Leave off until the credits probe shows thinking
# passes through OpenRouter (docs/openrouter.md).
AGENT_RUNNER_THINKING=off

# Perpl dev account (MOV-255): an EOA that already owns an onboarded Perpl
# testnet account, so dev runs never re-spend the 100 AUSD minimum. Testnet
# only, server-side only. The EOA, not a smart account: Perpl enrolls API keys
# by ecrecover only (docs/monad-testnet-assets.md). The API key and its
# Ed25519 secret (0x-hex, 32 bytes) sign REST/WS requests; they can trade but
# never withdraw. Used by `pnpm --filter @sente/venues run live:perpl`.
PERPL_DEV_PRIVATE_KEY=
PERPL_DEV_API_KEY=
PERPL_DEV_API_SECRET=

# Base URL of services/api as seen from the device. In development on a
# physical device this must be your machine's LAN IP, not localhost — the
# phone's localhost is the phone.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Chain the mobile app talks to: "testnet" (10143) or "mainnet" (143).
EXPO_PUBLIC_MONAD_NETWORK=testnet

# Optional RPC override for the mobile app. Falls back to the chain's default
# public RPC from viem when unset.
EXPO_PUBLIC_MONAD_RPC_URL=

# Optional PUBLIC (keyless) bundler endpoint for the app, used READ-ONLY to poll
# UserOperation receipts as one half of the confirmation race. Never put a keyed
# URL here: EXPO_PUBLIC_* is inlined into the app bundle and is not secret.
# Leave unset and the race simply runs on our API's status view alone.
EXPO_PUBLIC_BUNDLER_URL=https://public.pimlico.io/v2/10143/rpc

# ---------------------------------------------------------------------------
# Nansen smart-money signals (SEN-29)
#
# The agents' `smart_money_signals` read tool. Free API key from
# app.nansen.ai/auth/agent-setup; server-side only. Unset, the tool answers
# `not_configured` and the run carries on without it. Nansen covers Monad
# MAINNET only — the tool is context for our testnet trades, never a mirror
# of the venue book. Responses cache 10 minutes because the free plan is 100
# credits, then ~10 a day. Details: docs/nansen.md.
# ---------------------------------------------------------------------------
NANSEN_API_KEY=

# ---------------------------------------------------------------------------
# The user's wallet (SEN-40)
#
# A Privy server wallet per signed-in user, OWNED by the phone's `device` P-256
# key (SEN-38) — so this API creates it and can never sign for it. It reads
# PRIVY_APP_ID and PRIVY_APP_SECRET above and NOTHING ELSE: the two
# authorization keys belong to agent wallets, and a user wallet deliberately has
# no server-held signer. Unset both and `POST /wallet/register` refuses with
# `user_wallets_unconfigured`; set one and boot fails, naming the other.
#
# `GET /wallet` also reads MON, USDC and AUSD balances over MONAD_TESTNET_RPC_URL
# (viem's public default when unset); the token addresses come from
# @sente/venues, never from a variable. Details: docs/user-wallet.md.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Who owns a hired agent's mandate (SEN-43)
#
# `device` (the default, and what you want): at hire and at fork the agent's
# Privy policy AND wallet are owned by the caller's own device-key quorum — the
# one `POST /wallet/register` created (SEN-40) over the phone's `device` P-256
# key. This API creates those objects and from that moment cannot change them:
# PRIVY_MANDATE_OWNER_KEY gets 401 on both (verified live, see
# docs/privy-policy-enforcement.md §Phase 3). A caller with no registered wallet
# is refused `wallet_not_registered`. Amend and revoke need the phone's
# signature (SEN-44); until that lands, a device-owned mandate cannot be
# amended, and revoke still stops the agent but leaves its policy armed.
#
# `server`: the pre-Phase-3 shape, owner = PRIVY_MANDATE_QUORUM_ID, so this
# server can still amend and revoke. The scripted refusal demo needs it. It is
# a dev/demo mode and boot REFUSES it when NODE_ENV=production.
# ---------------------------------------------------------------------------
AGENT_MANDATE_OWNER=

# ---------------------------------------------------------------------------
# Persistent state (SEN-48)
#
# Where the API keeps the two stores whose loss costs a wallet rather than a
# restart: the user-wallet registry (`<STATE_DIR>/user-wallets.json`) and the
# agent store (`<STATE_DIR>/agents.json`). UNSET, BOTH STAY IN MEMORY, exactly
# as before — set it and they survive a restart.
#
# Set this for anything you would be sorry to lose. A Privy wallet's address is
# not derivable from the device key, so a forgotten binding is not "register
# again": the next `POST /wallet/register` mints a SECOND wallet and the funded
# one becomes unreachable from the app. An agent record is the same class of
# loss — the wallet, the mandate policy and the ERC-8004 id live on at their
# providers under ids nothing here would remember.
#
# A relative path resolves against the process's cwd. The directory is created
# on the first write (0700, files 0600) and is gitignored. A state file that
# exists and does not parse FAILS THE BOOT, naming the path — starting with an
# empty registry is the failure this whole thing prevents.
#
# Lost one anyway? `pnpm --filter @sente/api run privy:recover` finds a user's
# wallet again from the device public key: Privy's `GET /v1/wallets` does list
# them (its policy and quorum LIST endpoints answer 405), and each user wallet's
# owner quorum holds exactly that key.
# ---------------------------------------------------------------------------
STATE_DIR=services/api/.state

# ---------------------------------------------------------------------------
# ERC-8004 identity and reputation (SEN-27, services/api/src/agents/reputation)
#
# Every hired agent is minted an identity on the ERC-8004 Identity Registry, and
# each settled thesis is written to the Reputation Registry as realised PnL in
# basis points. UNSET, THE API BOOTS AND HIRES AS BEFORE: the agent simply has
# no `erc8004AgentId` and no feedback is written. A MALFORMED key fails the
# boot, naming the variable and never echoing the value.
#
# The registry addresses are constants, not variables — the testnet pair has no
# code on mainnet and the mainnet pair none on testnet, so choosing them by
# environment is a way to send a transaction to an empty address. The reads and
# writes reuse MONAD_TESTNET_RPC_URL above. Details: docs/erc8004.md.
# ---------------------------------------------------------------------------

# Funded EOA that signs `register`, and therefore OWNS every agent NFT Sente
# mints. Required to enable ERC-8004 at all. 0x-prefixed 32-byte hex.
# HIGHLY SENSITIVE — server-side only.
ERC8004_REGISTRAR_KEY=

# Funded EOA that signs `giveFeedback`. MUST NOT BE THE REGISTRAR: the spec
# forbids self-feedback and the live registry reverts with "Self-feedback not
# allowed" — and Monad charges the gas limit on a revert (gotcha 4), so the API
# refuses the write rather than sending it. Unset, identity still works and
# reputation is refused with `reviewer_unconfigured`.
ERC8004_REVIEWER_KEY=

# Where an agent's Ledger lives; the registration file points at
# `{base}/agents/{id}`. Default https://sente.lol.
ERC8004_AGENT_BASE_URL=https://sente.lol

# Shared MCP endpoint advertised in the registration file's `services`.
# Optional, and omitted from the file when unset.
ERC8004_MCP_ENDPOINT=

# The registration file's `image`. Optional, and deliberately left unset rather
# than invented: Sente hosts no agent image, and a URL that 404s is worse than a
# missing optional field.
ERC8004_IMAGE_URL=

# Fixed gas limits, measured 2026-09-17 against the live registries with the
# exact calldata the module builds (`register` 685k for a typical agentURI and
# 850k for the largest the builder can produce; `giveFeedback` 278k-296k). Monad
# charges on the LIMIT, so these are measured constants and never an
# estimateGas at runtime. Defaults 950000 and 350000.
ERC8004_REGISTER_GAS=950000
ERC8004_FEEDBACK_GAS=350000

# ---------------------------------------------------------------------------
# Alchemy Notify webhook (SEN-30, services/api/src/webhooks)
#
# `POST /webhooks/alchemy` appends a `deposit` event to a hired agent's Ledger
# when funds reach its wallet, and each hire adds its new wallet to the webhook's
# address list. UNSET, THE API BOOTS AND HIRES EXACTLY AS BEFORE: the route
# refuses every call with 503 `webhook_unconfigured` — never "accepted
# unverified", because the signature is the only thing authenticating a PUBLIC
# route that writes — and a hire registers no address. Nothing here can fail the
# boot.
#
# The three are different secrets from different places in the dashboard; see the
# runbook in docs/alchemy.md for which value is which.
#
# NOT an Alchemy variable despite the name: ALCHEMY_RPC_URL /
# ALCHEMY_GAS_POLICY_ID near the top are the Gas Manager paymaster
# (WALLET_PAYMASTER_PROVIDER=alchemy), a separate integration point.
# ---------------------------------------------------------------------------

# The PER-WEBHOOK signing key Alchemy HMAC-SHA256s every delivery with (webhook
# detail page, top right). Unset, the route refuses everything.
# SENSITIVE — server-side only; it is what proves a delivery came from Alchemy.
ALCHEMY_WEBHOOK_SIGNING_KEY=

# The app's Notify AUTH TOKEN (Webhooks dashboard, "AUTH TOKEN" button). A
# DIFFERENT secret from the signing key: this one authenticates US calling
# Alchemy, to add an address. SENSITIVE — server-side only.
ALCHEMY_NOTIFY_AUTH_TOKEN=

# Which webhook a hire adds the new agent's wallet to (`wh_...`, shown on the
# webhook in the dashboard). Not secret, but useless on its own.
ALCHEMY_NOTIFY_WEBHOOK_ID=

# Optional. How long a Notify address registration may take before a hire gives
# up on it. The registration is best effort either way — a failure is logged and
# never fails the hire — so this only bounds how long a hire waits for it.
ALCHEMY_NOTIFY_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Agent leaderboard and the indexer (SEN-25, SEN-26)
#
# `GET /leaderboard` ranks settled performance read from the Envio HyperIndex in
# services/indexer. Unset, the API boots and the route answers
# `source: { kind: 'unconfigured' }` with a note saying so — not an empty board,
# and not invented numbers. A malformed URL FAILS THE BOOT.
# Details: docs/leaderboard.md.
# ---------------------------------------------------------------------------

# Envio HyperIndex's GraphQL (Hasura) endpoint. Locally, with `npx envio dev`
# running in services/indexer, that is http://localhost:8080/v1/graphql.
ENVIO_GRAPHQL_URL=

# Read by services/indexer, NOT by the API: the RPC its account-address backfill
# calls, for accounts that registered before the indexed window. Default
# https://testnet-rpc.monad.xyz, the same fallback config.yaml names.
ENVIO_MONAD_RPC_URL=

# ---------------------------------------------------------------------------
# The rest of what services/api reads at boot
# ---------------------------------------------------------------------------

# Port services/api listens on. Default 3000.
PORT=3000

# `on` (the default) or `off`. `off` skips the mandate pre-check that runs
# before every venue write, leaving only the Privy enclave between an agent and
# the venues — Perpl order size and leverage then have NO check at all. It
# exists only for the demo that shows the enclave refusing on its own, and boot
# REFUSES it when NODE_ENV=production. Any other value fails the boot: a typo in
# a safety switch should not be guessed at.
AGENT_PRECHECK=on

# ---------------------------------------------------------------------------
# Reverse proxy (SEN-51)
#
# How many proxies sit in front of this API. 0 (the default) means the API is
# reached directly, which is right for local development. Set it to the exact
# number of hops in production — `infra/docker-compose.yml` sets 1, for Caddy —
# because Express only reads `X-Forwarded-For` when told how far to trust it,
# and trusting one hop more than exists lets a client spoof its own IP address.
# Unset, the gas drip's per-IP rate limit counts every caller behind a proxy as
# one client.
# ---------------------------------------------------------------------------
TRUST_PROXY_HOPS=0
