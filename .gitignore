node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo
.expo/
.expo-shared/
ios/
android/
*.log
.env
.env.local
.DS_Store
.ralph-loop.sh

# Android signing keys. Losing the release key is unrecoverable and breaks
# passkey association for every user — see apps/mobile/keystores/README.md.
*.keystore
*.jks
apps/mobile/keystores/credentials.json

# STATE_DIR (SEN-48): the API's file-backed stores. Holds live wallet ids,
# agent ids and device PUBLIC keys for whoever ran this checkout — never a
# secret, never someone else's business.
.state/

# Claude Code agent worktrees
.claude/worktrees/

# Hermes subagent worktrees
.worktrees/

# Stray build output next to TS sources (SEN-6 removed a committed set that
# jest had been loading instead of the sources — CLAUDE.md gotcha 10). Real
# JS lives in dist/ or in config files such as metro.config.js.
packages/*/src/**/*.js
packages/*/scripts/*.js
apps/mobile/src/**/*.js
services/api/src/**/*.js
services/api/scripts/*.js
